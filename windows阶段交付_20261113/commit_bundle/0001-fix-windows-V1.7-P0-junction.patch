+def main() -> int:
+    print(f"工作目录：{WORK}\n")
+    for fn in (t01_junction, t02_undo_db_failure, t03_undo_unfinished_states,
+               t04_copy_then_replace, t06_pending_unselected, t07_ai_defaults,
+               t08_restore_backup, t09_table_qss, t10_startup_log,
+               t11_undo_happy_path):
